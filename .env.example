# Copy to .env.local. Never put credentials in NEXT_PUBLIC_* variables.
APP_URL=http://localhost:3000
SESSION_SECRET=
ADMIN_EMAIL=
# Generate with npm run admin:password. Format: scrypt:salt:hash
ADMIN_PASSWORD_HASH=

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM key; actual newlines, literal \n sequences, and one surrounding quote pair are normalized server-side.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_NAME=Registrations

# Actual organizer bank/UPI recipient. No demo/default payment recipient is used.
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=

# Public official WhatsApp Community invitation. Must be an HTTPS chat.whatsapp.com invite URL.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/Kd4hu9LIUdm811J2EWKUX2

# Production persistent, private directory on a single Node server. Never use public/.
PRIVATE_STORAGE_DIR=./.private
# Local development is isolated from production. Use an absolute local path and
# configure a dedicated development Sheet only when explicitly approved.
LOCAL_PRIVATE_STORAGE_DIR=
ALLOW_LOCAL_GOOGLE_WRITES=false
LOCAL_GOOGLE_SHEET_ID=
LOCAL_GOOGLE_SHEET_NAME=Registrations
LOCAL_GOOGLE_SERVICE_ACCOUNT_EMAIL=
LOCAL_GOOGLE_PRIVATE_KEY=
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
