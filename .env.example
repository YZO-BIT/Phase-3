# Copy to .env.local. Never put these values in NEXT_PUBLIC_* variables.
APP_URL=http://localhost:3000
SESSION_SECRET=
ADMIN_EMAIL=
# Generate with npm run admin:password. Format: scrypt:salt:hash
ADMIN_PASSWORD_HASH=

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_NAME=Registrations

# Actual organizer bank/UPI recipient. No demo/default payment recipient is used.
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=

# Persistent, private directory on a single Node server. Never use public/.
PRIVATE_STORAGE_DIR=./.private
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
